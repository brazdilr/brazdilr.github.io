# HTML/CSS/JS Project .gitignore

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Dependencies
node_modules/

# Environment files
.env
.env.*
!.env.example

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Audio files (can be large) - ignorovat velké soubory
songs/*.mp3
songs/*.wav
songs/*.m4a
bardio-local/in/

# Ale ponechat existující ukázky
!songs/Renata.mp3

# Backup files
*.bak
*.backup
*.old

# Temporary files
*.tmp
*.temp
